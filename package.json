{
  "name": "arch-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quiz-quality": "vitest run src/lib/validate-quiz.test.ts src/lib/prompt-safety.test.ts src/lib/eval/quiz-metrics.test.ts src/lib/eval/quiz-prompt-contract.test.ts",
    "test:e2e": "playwright test",
    "test:quality": "npm run typecheck && npm run test && npm run test:e2e",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify:env": "node --import tsx --env-file=.env.local scripts/verify-env.mjs",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "test:db-security": "node --env-file=.env.local scripts/test-db-security.mjs",
    "test:live-auth": "node --import tsx --env-file=.env.local scripts/test-live-auth.mjs",
    "test:authenticated-browser": "node --env-file=.env.local scripts/test-authenticated-browser.mjs",
    "test:live-ai": "RUN_LLM_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/quiz-grading.integration.test.ts src/lib/eval/quiz-verifier.integration.test.ts",
    "test:learning-flows": "node --env-file=.env.local scripts/test-learning-flows.mjs",
    "test:prompt-live": "RUN_PROMPT_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/prompt-quality.integration.test.ts",
    "test:prompt-tools-live": "RUN_PROMPT_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/prompt-tools.integration.test.ts",
    "test:prompt-flows": "node --import tsx --env-file=.env.local scripts/test-prompt-flows.mjs",
    "test:auth-recovery": "node --env-file=.env.local scripts/test-auth-recovery.mjs",
    "test:files": "vitest run src/lib/parsers",
    "test:files-live": "RUN_FILE_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/parsers/image-file.integration.test.ts",
    "test:prompt-stress-live": "RUN_PROMPT_STRESS=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/prompt-stress.integration.test.ts",
    "test:api-isolation": "node --env-file=.env.local scripts/test-api-isolation.mjs",
    "test:quiz-pipeline-live": "RUN_PIPELINE_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/quiz-pipeline-stress.integration.test.ts",
    "test:classification-live": "RUN_CLASSIFY_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/classification.integration.test.ts",
    "workflow:auth": "npm run test:live-auth && npm run test:api-isolation && npm run test:auth-recovery && npm run test:authenticated-browser",
    "workflow:files": "npm run test:files && npm run test:files-live",
    "workflow:ai": "npm run test:classification-live && npm run test:quiz-pipeline-live && npm run test:live-ai && npm run test:prompt-tools-live",
    "workflow:quality": "npm run check -- --error-on-warnings && npm run typecheck && npm run test && npm run check:docs && npm audit --audit-level=moderate && npm run build && npm run test:e2e -- --workers=2",
    "report:ai-costs": "node --import tsx --env-file=.env.local scripts/report-ai-costs.mjs",
    "test:job-recovery": "node --env-file=.env.local scripts/test-job-recovery.mjs",
    "test:job-results": "node --env-file=.env.local scripts/test-job-results.mjs",
    "test:job-worker-db": "node --env-file=.env.local scripts/test-job-worker-db.mjs",
    "test:job-worker-flows": "node --env-file=.env.local scripts/test-job-worker-flows.mjs",
    "test:job-worker-schedule": "node --env-file=.env.local scripts/test-job-worker-schedule.mjs",
    "test:job-worker-schedule-live": "node --env-file=.env.local scripts/test-job-worker-schedule.mjs --live",
    "worker:enable": "node --env-file=.env.local scripts/configure-job-worker.mjs --enable",
    "worker:disable": "node --env-file=.env.local scripts/configure-job-worker.mjs --disable",
    "workflow:worker": "vitest run src/app/api/internal/material-jobs/recover/route.test.ts && npm run test:job-worker-db && npm run test:job-worker-flows",
    "test:job-flows": "node --env-file=.env.local scripts/test-job-flows.mjs",
    "workflow:jobs": "vitest run src/lib/data/jobs.test.ts src/lib/data/material-job-result.test.ts src/lib/services/recover-material-job.test.ts src/lib/services/quiz-generation.test.ts src/lib/services/summarize-persistence.test.ts && npm run test:job-recovery && npm run test:job-results && npm run test:job-flows",
    "test:pwa": "playwright test e2e/pwa.spec.ts --workers=2",
    "test:push": "vitest run src/lib/push-schema.test.ts src/lib/push.test.ts src/lib/services/push-reminders.test.ts src/app/api/push/subscriptions/route.test.ts src/app/api/internal/push-reminders/route.test.ts",
    "test:push-db": "node --env-file=.env.local scripts/test-push-reminders-db.mjs",
    "test:push-browser": "playwright test e2e/push-reminders.spec.ts --workers=2",
    "test:study-plans": "vitest run src/lib/study-plan.test.ts src/lib/data/study-plans.test.ts src/app/api/study-plans/route.test.ts",
    "test:study-plans-db": "node --env-file=.env.local scripts/test-study-workspace-db.mjs",
    "test:study-plans-browser": "playwright test e2e/study-plans.spec.ts --workers=2",
    "push:enable": "node --env-file=.env.local scripts/configure-push-reminders.mjs --enable",
    "push:disable": "node --env-file=.env.local scripts/configure-push-reminders.mjs --disable",
    "test:shared-rate-limits": "node --env-file=.env.local scripts/test-shared-rate-limits.mjs",
    "test:rate-limit-flows": "node --env-file=.env.local scripts/test-rate-limit-flows.mjs",
    "test:summary-chunks-live": "node --env-file=.env.local scripts/test-summary-chunks.mjs",
    "test:summary-quality-live": "node --env-file=.env.local scripts/test-summary-chunks.mjs --quality && node --env-file=.env.local scripts/test-summary-chunks.mjs --quality --statistics",
    "test:quiz-job-live": "node --env-file=.env.local scripts/test-summary-chunks.mjs --quiz",
    "workflow:limits": "vitest run src/lib/ratelimit.test.ts src/lib/ratelimit-shared.test.ts src/lib/ratelimit-failure.test.ts src/lib/monthly-budget-guard.test.ts && npm run test:shared-rate-limits && npm run test:rate-limit-flows",
    "test:model-upgrade-live": "RUN_MODEL_UPGRADE_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/model-upgrade.integration.test.ts",
    "test:wizard-upgrade-live": "RUN_WIZARD_UPGRADE_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/wizard-upgrade.integration.test.ts",
    "test:summary-100-live": "RUN_LONG_SUMMARY_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/summary-100-pages.integration.test.ts",
    "test:content-quality-live": "RUN_CONTENT_QUALITY_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/content-quality.integration.test.ts",
    "test:grading-quality-live": "RUN_GRADING_QUALITY_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/eval/grading-quality.integration.test.ts",
    "test:pdf-ocr-live": "RUN_PDF_OCR_EVAL=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/parsers/pdf-ocr.integration.test.ts",
    "test:self-assessment-live": "node --env-file=.env.local scripts/test-self-assessment-live.mjs",
    "test:release-live": "node --env-file=.env.local scripts/test-release-live.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.131",
    "@ai-sdk/google": "^3.0.133",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^6.0.307",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-type": "^22.2.0",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "16.4.1",
    "officeparser": "8.1.1",
    "p-limit": "^7.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "^10.5.0",
    "tailwind-merge": "^3.7.0",
    "tiktoken": "^1.0.22",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "husky": "^9.1.7",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
