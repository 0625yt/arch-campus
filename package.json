{
  "name": "arch-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quiz-quality": "vitest run src/lib/validate-quiz.test.ts src/lib/prompt-safety.test.ts src/lib/eval/quiz-metrics.test.ts src/lib/eval/quiz-prompt-contract.test.ts",
    "test:e2e": "playwright test",
    "test:quality": "npm run typecheck && npm run test && npm run test:e2e",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify:env": "node --env-file=.env.local scripts/verify-env.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/google": "^3.0.80",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.177",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "officeparser": "^6.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.5.0",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
